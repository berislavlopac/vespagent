# VESPA configuration — copy to .env and adjust, or set as real environment
# variables (which always take precedence). Models are Pydantic AI
# "provider:model" strings.

# Default model for every role.
VESPA_DEFAULT_MODEL=anthropic:claude-opus-4-8

# Optional per-role overrides (fall back to VESPA_DEFAULT_MODEL when unset).
#VESPA_FACILITATOR_MODEL=google:gemini-2.5-pro
#VESPA_MODELER_MODEL=ollama:qwen3:14b

# Provider credentials/endpoints are deliberately NOT read from this file.
# Set them in the actual process environment (shell, direnv, secret manager,
# CI secrets); Pydantic AI reads these native variables and fails loudly if
# the configured provider's key is missing:
#   ANTHROPIC_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY, OLLAMA_BASE_URL, ...

# Tip: VESPA_DEFAULT_MODEL=test uses Pydantic AI's offline TestModel —
# runs the whole loop without any API key (canned outputs; for smoke tests).